{
  "name": "attaie-callcenter-desktop",
  "version": "2.0.1",
  "description": "Attaie Properties Call Center Workspace — Desktop Application",
  "author": "Attaie Properties",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "build:web": "node ../scripts/build-desktop-apps.mjs",
    "prepack:win": "npm run build:web",
    "prepack:mac": "npm run build:web",
    "prepack:linux": "npm run build:web",
    "start": "electron .",
    "pack:win": "electron-builder --win",
    "pack:mac": "electron-builder --mac",
    "pack:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
